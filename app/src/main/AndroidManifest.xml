<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sending SMS. A "dangerous" permission: also requested at runtime (ConversationActivity). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Receiving SMS (SmsReceiver). Also requested at runtime, when the app starts. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- SMS needs a phone radio, but don't hide the app from devices without one. -->
    <!-- Bonus: call a contact directly from the app. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FtHangouts">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.ContactEditActivity" android:exported="false" />
        <activity android:name=".ui.ContactDetailActivity" android:exported="false" />
        <activity android:name=".ui.ConversationActivity" android:exported="false" />

        <!--
          Incoming SMS. Declared here (not in code) so it runs even when the app is closed.
          android:permission: only the system, which holds BROADCAST_SMS, may call it.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Told by Android whether each SMS we sent was accepted by the network. -->
        <receiver android:name=".sms.SmsSentReceiver" android:exported="false" />

    </application>

</manifest>
