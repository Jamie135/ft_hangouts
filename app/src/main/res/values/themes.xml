<resources>
    <!-- Plain Android Material theme (built into the system, no library needed). -->
    <style name="Theme.FtHangouts" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <!-- Dark status bar icons, readable on the light background. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
