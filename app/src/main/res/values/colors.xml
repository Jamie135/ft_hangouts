<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="white">#FFFFFFFF</color>

    <!-- Material surfaces (night versions in values-night/colors.xml). -->
    <color name="background">#FFF4F5F8</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_variant">#FFE7E8EE</color>
    <color name="outline">#FFD3D5DD</color>
    <!-- Launcher icon: white 42 logo on black. -->
    <color name="ic_launcher_background">#FF000000</color>

    <!-- Conversation bubbles: sent = right (theme colour), received = left. -->
    <color name="bubble_sent_text">#FFFFFFFF</color>
    <color name="bubble_sent_time">#B3FFFFFF</color>
    <color name="bubble_received">#FFE8E8EC</color>
    <color name="bubble_received_text">#DE000000</color>
    <color name="bubble_received_time">#8A000000</color>

    <!-- Choices in the "Header colour" menu. Same order as header_color_names. -->
    <color name="header_blue">#FF1E88E5</color>
    <color name="header_red">#FFE53935</color>
    <color name="header_green">#FF43A047</color>
    <color name="header_purple">#FF8E24AA</color>
    <color name="header_orange">#FFF57C00</color>
    <color name="header_teal">#FF00897B</color>
    <color name="header_grey">#FF455A64</color>

    <array name="header_colors">
        <item>@color/header_blue</item>
        <item>@color/header_red</item>
        <item>@color/header_green</item>
        <item>@color/header_purple</item>
        <item>@color/header_orange</item>
        <item>@color/header_teal</item>
        <item>@color/header_grey</item>
    </array>
</resources>
