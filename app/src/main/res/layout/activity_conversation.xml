<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- stackFromBottom: like a chat app, messages fill the screen from the bottom. -->
        <ListView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingVertical="8dp"
            android:stackFromBottom="true"
            android:transcriptMode="normal" />

        <TextView
            android:id="@+id/empty_messages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_date_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/no_messages"
            android:textColor="?android:attr/textColorSecondary" />
    </FrameLayout>

    <!-- Input bar: rounded message box and round send button. BaseActivity pads the
         screen above the keyboard, so it stays visible. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:hint="@string/hint_message"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp" />

        <ImageButton
            android:id="@+id/button_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/action_send"
            android:elevation="2dp"
            android:enabled="false"
            android:alpha="0.4"
            android:paddingStart="4dp"
            android:src="@drawable/ic_send"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
