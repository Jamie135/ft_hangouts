<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView so the form still fits in landscape. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tapping the picture or "Add photo" opens the system picker. -->
        <include
            android:id="@+id/edit_avatar"
            layout="@layout/view_avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_photo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_add_photo" />

            <Button
                android:id="@+id/button_remove_photo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_remove_photo" />
        </LinearLayout>

        <TextView style="@style/FieldLabel"
            android:labelFor="@+id/edit_first_name" android:text="@string/label_first_name" />
        <EditText android:id="@+id/edit_first_name" style="@style/FieldInput"
            android:autofillHints="givenName" android:inputType="textPersonName|textCapWords" />

        <TextView style="@style/FieldLabel"
            android:labelFor="@+id/edit_last_name" android:text="@string/label_last_name" />
        <EditText android:id="@+id/edit_last_name" style="@style/FieldInput"
            android:autofillHints="familyName" android:inputType="textPersonName|textCapWords" />

        <TextView style="@style/FieldLabel"
            android:labelFor="@+id/edit_company" android:text="@string/label_company" />
        <EditText android:id="@+id/edit_company" style="@style/FieldInput"
            android:autofillHints="organization" android:inputType="textCapWords" />

        <TextView style="@style/FieldLabel"
            android:labelFor="@+id/edit_phone" android:text="@string/label_phone" />
        <EditText android:id="@+id/edit_phone" style="@style/FieldInput"
            android:autofillHints="phone" android:inputType="phone" />

        <TextView style="@style/FieldLabel"
            android:labelFor="@+id/edit_email" android:text="@string/label_email" />
        <EditText android:id="@+id/edit_email" style="@style/FieldInput"
            android:autofillHints="emailAddress" android:inputType="textEmailAddress" />

        <TextView style="@style/FieldLabel"
            android:labelFor="@+id/edit_address" android:text="@string/label_address" />
        <EditText android:id="@+id/edit_address" style="@style/FieldInput"
            android:autofillHints="postalAddress"
            android:inputType="textPostalAddress|textMultiLine|textCapWords" />


        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_save" />
    </LinearLayout>
</ScrollView>
