<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bottom padding so the last contact can scroll above the round + button. -->
    <ListView
        android:id="@+id/contact_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:listSelector="@android:color/transparent"
        android:paddingTop="4dp"
        android:paddingBottom="88dp"
        android:scrollbarStyle="outsideOverlay" />

    <!-- Shown automatically by ListView.setEmptyView() when there are no contacts. -->
    <LinearLayout
        android:id="@+id/empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_tonal_circle"
            android:importantForAccessibility="no"
            android:padding="28dp"
            android:src="@drawable/ic_person"
            android:tint="?android:attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/no_contacts"
            android:textAppearance="@android:style/TextAppearance.Material.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_contacts_hint"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- Floating action button (Material): add a contact. -->
    <ImageButton
        android:id="@+id/fab_add_contact"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/action_add_contact"
        android:elevation="6dp"
        android:src="@drawable/ic_add"
        android:tint="@color/white" />
</FrameLayout>
